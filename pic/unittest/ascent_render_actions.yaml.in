- action: "add_pipelines"
  pipelines:
    vector_fields:
      magnitude:
        type: "vector_magnitude"
        params:
          field: "E"
          output_name: "E_magnitude"
- action: "add_scenes"
  scenes:
    picnix_E:
      plots:
        E_plot:
          type: "pseudocolor"
          field: "E_magnitude"
          pipeline: "vector_fields"
      image_name: "ascent_picnix_E"
    picnix_M0:
      plots:
        M0_plot:
          type: "pseudocolor"
          field: "um00_M0"
      image_name: "ascent_picnix_M0"
